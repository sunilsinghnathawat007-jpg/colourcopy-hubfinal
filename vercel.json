{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "onlinecolourprint.com" }],
      "destination": "https://www.onlinecolourprint.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/mbbs-book-printing", "destination": "/index.html" },
    { "source": "/neet-notes-printing", "destination": "/index.html" },
    { "source": "/ca-cfa-notes-printing", "destination": "/index.html" },
    { "source": "/photocopy-online-jaipur", "destination": "/index.html" },
    { "source": "/core-btr-3", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
